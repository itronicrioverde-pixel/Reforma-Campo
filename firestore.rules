rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null
        && request.auth.token.email == 'itronicrioverde@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /reforma/{bucket} {
      allow read: if owner() && bucket in ['expenses', 'income', 'donations', 'loans'];
      allow create: if owner() && bucket in ['expenses', 'income', 'donations', 'loans']
        && request.resource.data.keys().hasOnly(['items','version'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 2000
        && request.resource.data.version == 2;
      allow update: if owner() && bucket in ['expenses', 'income', 'donations', 'loans']
        && request.resource.data.keys().hasOnly(['items','version'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 2000
        && request.resource.data.version == resource.data.version + 1;
    }
  }
}
